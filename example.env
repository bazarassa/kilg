# ---------- HTTP / gateway ----------
# Gateway HTTP listen address
HTTP_ADDR=:8080
# Worker HTTP listen address (health/metrics)
WORKER_HTTP_ADDR=:8081
# Comma-separated API keys; empty disables auth
API_KEYS=REDACTED

# ---------- Kafka ----------
# Comma-separated broker list
KAFKA_BROKERS=REDACTED:9092
KAFKA_REQUEST_TOPIC=llm.requests
KAFKA_EVENTS_TOPIC=llm.events
KAFKA_COMPLETED_TOPIC=llm.completed
KAFKA_FAILED_TOPIC=llm.failed
KAFKA_DLQ_TOPIC=llm.dlq
KAFKA_CONSUMER_GROUP=gateway
KAFKA_WORKER_GROUP=heavy-llm-worker
# Auto-create topics on startup
KAFKA_AUTO_CREATE=true
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=1
# "latest" or "earliest"
KAFKA_CONSUMER_START=latest
# Comma-separated "advertised=actual" broker address rewrites (useful for Docker/remote)
KAFKA_ADDRESS_REWRITE=REDACTED:9093=REDACTED:9092

# ---------- Heavy LLM (OpenAI-compatible, e.g. LLM) ----------
OPENAI_BASE_URL=https://50.tk1tez.online/v1
OPENAI_MODEL=HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF:Q6_K_P
# Empty = no API key sent
OPENAI_KEY=REDACTED
# Go duration strings: 2h, 10m, 30s ...
HEAVY_LLM_TIMEOUT=2h
# Max time without a chunk before the stream is considered dead
HEAVY_LLM_IDLE_TIMEOUT=10m
# Max concurrent heavy generations
HEAVY_WORKERS=2
HEAVY_MAX_RETRY=3
# Stream heartbeat interval
HEAVY_HEARTBEAT=30s

# ---------- LiteLLM ----------
LITELLM_URL=http://10.0.0.150:8081/v1
#LITELLM_MODEL=gemma-4-E4B-it-GGUF
LITELLM_MODEL=gemma-2-2b-it-Q8_0
LITELLM_API_KEY=REDACTED
LITELLM_TIMEOUT=5m

# ---------- Ollama ----------
OLLAMA_URL=http://REDACTED:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=5m

# ---------- Misc ----------
CONTEXT_WINDOW=8192
# Per-request in-memory SSE buffer size (KB)
SSE_BUFFER_SIZE=1024
# debug | info | warn | error
LOG_LEVEL=info

